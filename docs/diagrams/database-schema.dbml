// MongoDB documentation view generated from Mongoose models, 2026-11-17.
// Not a SQL migration. Ref lines are logical associations, not enforced MongoDB foreign keys.
// ObjectIds use varchar here; embedded objects/maps/arrays use json.
// Partial/compound/TTL indexes are documented in database-schema.json and README.md.

Table acquisitionattempts {
  attempt_key varchar
  project_id varchar
  run_id varchar
  source varchar
  status varchar
  reason_code varchar
  route varchar
  duration_ms double
  started_at timestamp
  completed_at timestamp
  _id varchar [pk, note: 'MongoDB ObjectId']
  Note: 'Mongoose source: models/AcquisitionAttempt.js; embedded subdocuments are not separate collections.'
}

