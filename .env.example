# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=moneytamngan
# Optional override for macOS/Node Atlas SRV resolution failures.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Atlas Admin API key (Project Settings > Access Manager > API Keys, role
# "Project Owner") used by scripts/atlas-allow-ip.sh / docker-compose.atlas.yml
# to allowlist your current public IP automatically.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
# The 24-hex id in the Atlas URL: cloud.mongodb.com/v2/<ATLAS_PROJECT_ID>
ATLAS_PROJECT_ID=
# How long each auto-added IP stays allowed (max 168 = one week).
ATLAS_ALLOWLIST_TTL_HOURS=168
EGP_API_KEY=

# Google OAuth (authorization-code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the Google Cloud console.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Secret used to sign the session JWT (mtn_session cookie). Use a long random string.
JWT_SECRET=

# Public read-only API (/api/tors, /api/projects) requests per minute.
# Guests are keyed by X-Forwarded-For / X-Real-IP, signed-in users by account.
RATE_LIMIT_GUEST_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=300

# Document acquisition
SCRAPER_DELAY_MS=4000
ENABLE_BROWSER_FALLBACK=true
# Retry the official related-document list because e-GP intermittently returns E1530.
EGP_DETAIL_RETRY_ATTEMPTS=5
EGP_DOWNLOAD_TIMEOUT_MS=300000
# Disabled by default because the search page requires Cloudflare verification.
ENABLE_LEGACY_EGP_SEARCH_FALLBACK=false
TOR_MAX_FILE_SIZE_MB=250
TOR_ZIP_MAX_ENTRIES=200
TOR_ZIP_MAX_PDF_MB=100
TOR_ZIP_MAX_EXTRACTED_MB=200
TOR_ZIP_MAX_COMPRESSION_RATIO=200
TOR_STORAGE_BACKEND=local
TOR_STORAGE_DIR=storage/tor
# Keep only official links, hashes, OCR text, and summaries by default.
TOR_RETAIN_SOURCE_FILES=false

# Change TOR_STORAGE_BACKEND to gcs in production.
TOR_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Vertex is opt-in so local ingestion and downloads work without cloud credentials.
# OCR runs locally before Vertex. Set true to OCR all pages even if text is embedded.
OCR_FORCE=false
OCR_DPI=300
OCR_MAX_DIMENSION=5000
VERTEX_AI_ENABLED=false
VERTEX_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_MS=300000
VERTEX_REVIEW_THRESHOLD=0.8

# Database-backed worker
WORKER_POLL_MS=5000
