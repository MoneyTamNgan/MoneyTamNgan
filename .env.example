MONGODB_URI=mongodb://127.0.0.1:27017/money-tam-ngan
MONGODB_DB_NAME=moneytamngan
# Optional override for macOS/Node Atlas SRV resolution failures.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
EGP_API_KEY=

# Document acquisition
SCRAPER_DELAY_MS=4000
ENABLE_BROWSER_FALLBACK=true
# Retry the official related-document list because e-GP intermittently returns E1530.
EGP_DETAIL_RETRY_ATTEMPTS=5
# Disabled by default because the search page requires Cloudflare verification.
ENABLE_LEGACY_EGP_SEARCH_FALLBACK=false
TOR_MAX_FILE_SIZE_MB=100
TOR_ZIP_MAX_ENTRIES=200
TOR_ZIP_MAX_PDF_MB=100
TOR_ZIP_MAX_EXTRACTED_MB=200
TOR_ZIP_MAX_COMPRESSION_RATIO=200
TOR_STORAGE_BACKEND=local
TOR_STORAGE_DIR=storage/tor

# Change TOR_STORAGE_BACKEND to gcs in production.
TOR_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Vertex is opt-in so local ingestion and downloads work without cloud credentials.
VERTEX_AI_ENABLED=false
VERTEX_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_MS=120000
VERTEX_REVIEW_THRESHOLD=0.8

# Database-backed worker
WORKER_POLL_MS=5000
