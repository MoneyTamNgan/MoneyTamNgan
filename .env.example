# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=moneytamngan
# Optional override for macOS/Node Atlas SRV resolution failures.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Atlas Admin API key (Project Settings > Access Manager > API Keys, role
# "Project Owner") used by scripts/atlas-allow-ip.sh / docker-compose.atlas.yml
# to allowlist your current public IP automatically.
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
# The 24-hex id in the Atlas URL: cloud.mongodb.com/v2/<ATLAS_PROJECT_ID>
ATLAS_PROJECT_ID=
# How long each auto-added IP stays allowed (max 168 = one week).
ATLAS_ALLOWLIST_TTL_HOURS=168
EGP_API_KEY=

# Google OAuth (authorization-code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the Google Cloud console.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Comma-separated list of admin email addresses automatically granted admin role on login.
ADMIN_EMAILS=admin@example.com,admin@bangkok.go.th

# Secret used to sign the session JWT (mtn_session cookie). Use a long random string.
JWT_SECRET=
# Optional CLI credential, at least 32 random characters. Never use NEXT_PUBLIC_.
PIPELINE_ADMIN_TOKEN=
# Set the external HTTPS origin when running behind a reverse proxy.
APP_ORIGIN=

# Public read-only API (/api/tors, /api/projects, /api/analytics) requests per minute.
# Guests are keyed by X-Forwarded-For / X-Real-IP, signed-in users by account.
RATE_LIMIT_GUEST_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=300

# Document acquisition
# Optional RSS department hints for API/worker announcement lookup (up to 4 per job).
# The API request's rssDeptId or upstream four-digit dept_id takes priority.
EGP_RSS_DEPT_IDS=
SCRAPER_DELAY_MS=4000
ENABLE_BROWSER_FALLBACK=true
# Retry the official related-document list because e-GP intermittently returns E1530.
EGP_DETAIL_RETRY_ATTEMPTS=5
EGP_DOWNLOAD_TIMEOUT_MS=300000
# Disabled by default because the search page requires Cloudflare verification.
ENABLE_LEGACY_EGP_SEARCH_FALLBACK=false
TOR_MAX_FILE_SIZE_MB=250
TOR_ZIP_MAX_ENTRIES=200
TOR_ZIP_MAX_PDF_MB=100
TOR_ZIP_MAX_EXTRACTED_MB=200
TOR_ZIP_MAX_COMPRESSION_RATIO=200
TOR_STORAGE_BACKEND=local
TOR_STORAGE_DIR=storage/tor
# Keep only official links, hashes, OCR text, and summaries by default.
TOR_RETAIN_SOURCE_FILES=false

# Change TOR_STORAGE_BACKEND to gcs in production.
TOR_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Vertex is opt-in so local ingestion and downloads work without cloud credentials.
# OCR runs locally before Vertex. Set true to OCR all pages even if text is embedded.
OCR_FORCE=false
OCR_DPI=300
OCR_MAX_DIMENSION=5000
VERTEX_AI_ENABLED=false
VERTEX_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_MS=300000
VERTEX_MAX_ATTEMPTS=4
VERTEX_REVIEW_THRESHOLD=0.8

# Database-backed worker
WORKER_POLL_MS=5000
# Watch workers reconcile stranded projects only when the queue is idle.
# This can resume OCR/Vertex work and incur cloud charges when Vertex is enabled.
WORKER_RECOVERY_ENABLED=true
WORKER_RECOVERY_INTERVAL_MS=60000
WORKER_RECOVERY_BATCH_SIZE=10
WORKER_RECOVERY_SCAN_LIMIT=100

# Automated ingestion scheduler (npm run scheduler). Calls the app's pipeline
# endpoints with PIPELINE_ADMIN_TOKEN, so the app must be reachable here.
INGESTION_APP_URL=http://localhost:3000
# Comma-separated HH:MM times, or a fixed interval such as every:1h / every:30m.
INGESTION_SCHEDULE=06:00,12:00,18:00
INGESTION_TIMEZONE=Asia/Bangkok
# Transient failures retry with backoff ~5 → 15 → 45 min (base x3, ±20% jitter).
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BASE_MS=300000
INGESTION_REQUEST_TIMEOUT_MS=900000
# Optional cap on records fetched per run (1-1000, endpoint default 500).
INGESTION_LIMIT=
INGESTION_ENQUEUE_PROCESSING=true
# TOR scraping batch per run after metadata ingestion; 0 disables it.
INGESTION_SCRAPE_BATCH_SIZE=10
